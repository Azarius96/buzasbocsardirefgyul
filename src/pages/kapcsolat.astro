---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { contact, site } from '../data/site';
---

<BaseLayout
  title="Kapcsolat"
  description="A Búzásbocsárdi Református Egyházközség elérhetősége: parókia, lelkipásztor, e-mail, cím és térkép (Bucerdea Grânoasă, jud. Alba)."
>
  <PageHero
    eyebrow="Kapcsolat"
    title="Írjon nekünk, keresse a lelkipásztort"
    lead="Kérdés, bejelentés, templomlátogatás vagy családi ünnep egyeztetése – szívesen segítünk."
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="reveal border-moss-900/10 bg-sand-100 rounded-3xl border p-8">
        <h2 class="text-2xl">Elérhetőség</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="text-gold-600 text-xs font-semibold tracking-[0.18em] uppercase">
              Lelkipásztor
            </dt>
            <dd class="text-moss-900 mt-1 text-lg">{contact.minister}</dd>
            <dd class="text-moss-700/80">{contact.ministerTitle}</dd>
            <dd class="mt-1">
              <a
                class="text-moss-800 decoration-gold-400 hover:text-moss-950 underline underline-offset-4"
                href={`mailto:${contact.ministerEmail}`}>{contact.ministerEmail}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-gold-600 text-xs font-semibold tracking-[0.18em] uppercase">
              Egyházközség
            </dt>
            <dd class="mt-1">
              <a
                class="text-moss-800 decoration-gold-400 hover:text-moss-950 underline underline-offset-4"
                href={`mailto:${contact.parishEmail}`}>{contact.parishEmail}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-gold-600 text-xs font-semibold tracking-[0.18em] uppercase">Parókia</dt>
            <dd class="text-moss-800 mt-1">
              {contact.street}<br />
              {contact.postalCode}
              {contact.city}, {contact.county}<br />
              {contact.country}
            </dd>
          </div>
          <div>
            <dt class="text-gold-600 text-xs font-semibold tracking-[0.18em] uppercase">Templom</dt>
            <dd class="text-moss-800 mt-1">{contact.churchAddress}</dd>
          </div>
          <div>
            <dt class="text-gold-600 text-xs font-semibold tracking-[0.18em] uppercase">
              Egyházi szervezet
            </dt>
            <dd class="text-moss-800 mt-1">{site.presbytery}</dd>
            <dd class="text-moss-700/80">
              <a
                class="decoration-gold-400 underline underline-offset-4"
                href={site.dioceseUrl}
                rel="noopener noreferrer"
                target="_blank">{site.diocese}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal border-moss-900/10 flex flex-col overflow-hidden rounded-3xl border">
        <iframe
          title="A búzásbocsárdi református templom a térképen"
          class="min-h-80 w-full flex-1"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.openstreetmap.org/export/embed.html?bbox=23.830%2C46.185%2C23.851%2C46.198&layer=mapnik&marker=46.1917%2C23.8403"
        ></iframe>
        <div class="bg-sand-100 px-6 py-4 text-sm">
          <a
            class="text-moss-900 decoration-gold-400 font-semibold underline underline-offset-4"
            href={contact.mapUrl}
            rel="noopener noreferrer"
            target="_blank">Nagyobb térkép megnyitása</a
          >
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
