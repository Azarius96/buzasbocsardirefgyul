---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { ministers } from '../data/site';
---

<BaseLayout
  title="Lelkészek"
  description="A Búzásbocsárdi Református Egyházközség lelkipásztorai 1773-tól napjainkig, K. Benedek Sámueltől Szabó Lászlóig."
>
  <PageHero
    eyebrow="1773 – napjaink"
    title="Gyülekezetünk lelkipásztorai"
    lead="Két és fél évszázad szolgálattevői, akiknek munkája nyomán a búzásbocsárdi reformátusság megmaradt és épült."
  />

  <Section>
    <ol class="divide-moss-900/10 grid gap-x-8 divide-y sm:grid-cols-2 sm:gap-y-0 sm:divide-y-0">
      {
        ministers.map((minister) => (
          <li
            class:list={[
              'reveal flex items-center justify-between gap-3 py-2.5 text-sm',
              'current' in minister && minister.current && 'bg-sand-100 -mx-3 rounded-lg px-3 font-semibold',
            ]}
          >
            <span class="text-moss-900">
              {minister.name}
              {'current' in minister && minister.current && (
                <span class="text-gold-600"> · jelenleg</span>
              )}
            </span>
            <span class="text-moss-700/70 shrink-0">{minister.period}</span>
          </li>
        ))
      }
    </ol>
  </Section>
</BaseLayout>
