---
import { STATS_API_URL } from '../lib/publicApi';
---

<div class="reveal" data-live-stats>
  <p class="text-moss-800 font-serif text-4xl" data-stat="tagletszam">600</p>
  <p class="text-moss-900 mt-2 text-sm font-semibold">Jelenlegi taglétszám</p>
  <p class="text-moss-700/70 text-sm">Búzásbocsárdon és Alsókarácsonyfalván</p>
</div>
<div class="reveal" data-live-stats>
  <p class="text-moss-800 font-serif text-4xl" data-stat="elhunytak">–</p>
  <p class="text-moss-900 mt-2 text-sm font-semibold">Elhunyt <span data-stat="ev">ebben az évben</span></p>
  <p class="text-moss-700/70 text-sm">Az Úrban megpihent testvéreink</p>
</div>

<script is:inline define:vars={{ STATS_API_URL }}>
  fetch(STATS_API_URL)
    .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
    .then((data) => {
      const tagletszam = document.querySelector('[data-stat="tagletszam"]');
      const elhunytak = document.querySelector('[data-stat="elhunytak"]');
      const ev = document.querySelector('[data-stat="ev"]');
      if (tagletszam && typeof data.tagletszam === 'number') {
        tagletszam.textContent = String(data.tagletszam);
      }
      if (elhunytak && typeof data.elhunytakEbbenAzEvben === 'number') {
        elhunytak.textContent = String(data.elhunytakEbbenAzEvben);
      }
      if (ev && typeof data.ev === 'number') {
        ev.textContent = `${data.ev}-ban`;
      }
    })
    .catch(() => {
      // Ha a szerver épp nem elérhető, a beégetett alapértékek maradnak látható helyen -
      // a nyilvános honlap sosem törhet emiatt.
    });
</script>
