  viewBox="0 0 320 260"
  fill="none"
  role="img"
  aria-label="A búzásbocsárdi református templom stilizált rajza"
>
  <g stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
    <path d="M96 250h180" opacity="0.5"></path>
    <path d="M20 250h56" opacity="0.5"></path>
    <!-- fatorony -->
    <path d="M48 250V116"></path>
    <path d="M76 250V116"></path>
    <path d="M42 116h40"></path>
    <path d="M38 108l24-14 24 14H38z"></path>
    <path d="M62 94V64"></path>
    <path d="M44 64h36l-18-34-18 34z"></path>
    <path d="M62 30V14"></path>
    <path d="M54 22h16"></path>
    <path d="M48 150h28M48 186h28" opacity="0.6"></path>
    <!-- hajó -->
    <path d="M96 250V146l52-30 52 30v104"></path>
    <path d="M96 146h104" opacity="0.6"></path>
    <!-- szentély -->
    <path d="M200 250V168l40 22v60"></path>
    <path d="M240 190l32 18v42"></path>
    <!-- résablakok -->
    <path d="M124 178c0-7 5-12 11-12s11 5 11 12v34h-22v-34z" opacity="0.75"></path>
    <path d="M160 190c0-6 4-10 9-10s9 4 9 10v22h-18v-22z" opacity="0.6"></path>
