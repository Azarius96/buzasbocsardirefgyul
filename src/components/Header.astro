---
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header
  class="border-moss-900/10 bg-sand-50/85 supports-[backdrop-filter]:bg-sand-50/70 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-20">
    <a href="/" class="group flex items-center gap-3">
      <svg
        class="text-moss-700 h-9 w-9 shrink-0 transition-transform group-hover:-translate-y-0.5"
        viewBox="0 0 40 40"
        fill="none"
        aria-hidden="true"
      >
        <path d="M20 3v34" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        <path d="M12 11h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        <path
          d="M6 37V22L20 9l14 13v15"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          opacity="0.45"></path>
      </svg>
      <span class="leading-tight">
        <span class="text-moss-900 block font-serif text-lg font-semibold sm:text-xl"
          >Búzásbocsárdi</span
        >
        <span class="text-moss-600 block text-[0.7rem] font-medium tracking-[0.18em] uppercase"
          >Református Egyházközség</span
        >
      </span>
    </a>

    <nav aria-label="Főmenü" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-moss-800 text-sand-50'
                : 'text-moss-800 hover:bg-moss-900/5 hover:text-moss-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="group relative lg:hidden" id="mobile-nav">
      <summary
        class="border-moss-900/15 text-moss-800 hover:bg-moss-900/5 flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border transition-colors"
        aria-label="Menü megnyitása"
      >
        <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        aria-label="Mobil menü"
        class="border-moss-900/10 bg-sand-50 shadow-moss-950/10 absolute right-0 mt-3 w-64 overflow-hidden rounded-2xl border shadow-xl"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'border-moss-900/5 block border-b px-5 py-3 text-sm font-medium last:border-b-0',
                isActive(item.href)
                  ? 'bg-moss-800 text-sand-50'
                  : 'text-moss-800 hover:bg-moss-100',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // A mobil menü bezárása kattintásra, illetve Escape lenyomására.
  const details = document.getElementById('mobile-nav') as HTMLDetailsElement | null;
  if (details) {
    document.addEventListener('click', (event) => {
      if (details.open && !details.contains(event.target as Node)) details.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') details.open = false;
    });
  }
</script>
